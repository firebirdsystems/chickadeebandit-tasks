{
  "id": "tasks",
  "name": "Tasks",
  "version": "1.4.0",
  "description": "Create tasks with due dates, priorities, labels, recurrence, and subtasks. Assign to family members. Also syncs with Google Tasks and Apple Reminders.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "general",
  "tags": [
    "tasks",
    "reminders",
    "todo",
    "lists",
    "recurrence",
    "google",
    "apple"
  ],
  "contexts": ["household", "shared_space"],
  "data_access": {
    "reads": [
      "family.members"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "db_encryption": "off",
  "db_plaintext_columns": ["due_date"],
  "row_policies": {
    "lists": {
      "kind": "owner_or_visibility",
      "member_column": "member_id",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_visibility_scoped": true
    },
    "tasks": {
      "kind": "owner_only",
      "member_column": "assignee_id",
      "retain_days": {
        "default": 365,
        "timestamp_column": "completed_at",
        "override_key": "completed_tasks",
        "tier": "operational"
      }
    }
  },
  "member_references": {
    "tasks": [
      { "column": "assignee_id", "on_removed": "null" },
      { "column": "created_by", "on_removed": "keep" }
    ],
    "lists": {
      "column": "member_id",
      "on_removed": "delete",
      "only_when": { "column": "visibility", "values": ["private"] }
    },
    "inbox": { "column": "added_by_id", "on_removed": "keep" }
  },
  "automation_actions": {
    "create_task": {
      "title": "Add a task for a member",
      "description": "Create a task on someone's list when another app's event fires — a reimbursement to settle, a care task to run, a borrowing request to answer.",
      "params": {
        "assignee_id": { "type": "member", "label": "Who it's for", "required": true },
        "title": { "type": "text", "label": "Task title", "required": true },
        "notes": { "type": "text", "label": "Notes", "default": "" },
        "priority": { "type": "integer", "label": "Priority (0 low – 2 high)", "default": 0, "min": 0, "max": 2 }
      },
      "dedupe": { "table": "tasks", "column": "source_event_id" },
      "steps": [
        {
          "op": "insert",
          "table": "tasks",
          "values": {
            "id": "$uuid",
            "title": ":title",
            "notes": ":notes",
            "assignee_id": ":assignee_id",
            "priority": ":priority",
            "created_by": "automation",
            "created_at": "$now",
            "updated_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "suggested_automations": [
    {
      "title": "Turn an elder-care task into a task on the assignee's list",
      "description": "When the elder-care app records a task for someone, add it to their own Tasks list so it shows up on Today alongside everything else they owe.",
      "trigger_event": "elder_care.task_created",
      "target_app_id": "tasks",
      "action_id": "create_task",
      "param_map": {
        "assignee_id": { "kind": "payload_field", "value": "assignee_id" },
        "title": { "kind": "payload_field", "value": "title" }
      }
    },
    {
      "title": "Add a task when someone asks to be reimbursed",
      "description": "A reimbursement request in the expense splitter becomes a task for whoever owes the money, so it doesn't sit in a list nobody opens.",
      "trigger_event": "expense.reimbursement_requested",
      "target_app_id": "tasks",
      "action_id": "create_task",
      "param_map": {
        "assignee_id": { "kind": "payload_field", "value": "payer_id" },
        "title": { "kind": "const", "value": "Reimburse a shared expense" }
      }
    },
    {
      "title": "Add a task when someone asks to borrow your thing",
      "description": "A borrowing request becomes a task for the lender, so a request nobody noticed doesn't quietly expire.",
      "trigger_event": "borrowing.requested",
      "target_app_id": "tasks",
      "action_id": "create_task",
      "param_map": {
        "assignee_id": { "kind": "payload_field", "value": "lender_id" },
        "title": { "kind": "const", "value": "Answer a borrowing request" }
      }
    }
  ],
  "nav": {
    "label": "Tasks"
  },
  "kiosk_quick_add": {
    "table": "inbox",
    "label": "Add a task",
    "text_column": "title",
    "normalized_column": "title_normalized",
    "actions": ["add"],
    "attribution": { "id_column": "added_by_id", "name_column": "added_by_name" },
    "created_at_column": "created_at"
  },
  "capture_consumer": { "kinds": ["task"], "via": "structured" },
  "agenda": {
    "kind": "task",
    "label": "Tasks",
    "source": {
      "kind": "sql",
      "query": "SELECT id AS id, title AS title, CASE WHEN due_time IS NULL OR due_time = '' THEN due_date ELSE due_date || 'T' || due_time END AS when_at, (completed = 1) AS done, NULLIF(notes, '') AS subtitle, NULLIF(assignee_id, '') AS member_id FROM app_tasks__tasks WHERE due_date = :today AND parent_id IS NULL ORDER BY completed, priority DESC, due_time LIMIT 20"
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_tasks__tasks WHERE due_date = :today AND completed = 0 AND parent_id IS NULL LIMIT 1"
    },
    "display": {
      "template": "badge",
      "count": "n",
      "label": "tasks due today",
      "severity": "info"
    }
  },
  "widget": {
    "label": "Tasks",
    "size": "small"
  },
  "resource_limits": {
    "max_db_bytes": 104857600
  },
  "icon": "✅",
  "ai_access": {
    "allowed": true,
    "mode": "read_write",
    "db_exports": ["open_tasks", "overdue_tasks", "task_summary"],
    "db_mutations": ["complete_task", "reopen_task", "update_due_date", "reassign_task"],
    "db_inserts": ["add_task"]
  }
}
